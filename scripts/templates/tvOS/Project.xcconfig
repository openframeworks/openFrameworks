//THE PATH TO THE ROOT OF OUR OF PATH RELATIVE TO THIS PROJECT.
//THIS NEEDS TO BE DEFINED BEFORE CoreOF.xcconfig IS INCLUDED
OF_PATH = ../../..

//THIS HAS ALL THE HEADER AND LIBS FOR OF CORE
#include "../../../libs/openFrameworksCompiled/project/tvOS/CoreOF.xcconfig"

OF_NO_FMOD=1
USER_PREPROCESSOR_DEFINITIONS="OF_NO_FMOD=1"

OTHER_LDFLAGS = $(OF_CORE_LIBS) $(OF_CORE_FRAMEWORKS)
HEADER_SEARCH_PATHS = $(OF_CORE_HEADERS)

// Dawn (WebGPU / Metal). Rebuild tvOS+OFLib with the same flag. Do not combine with ANGLE.
// GCC_PREPROCESSOR_DEFINITIONS = $(inherited) OF_USE_DAWN=1
// OTHER_LDFLAGS = $(OF_CORE_LIBS) $(OF_CORE_FRAMEWORKS) $(OF_DAWN_LIBS)
//
// MetalANGLE. Drop OpenGLES and GLKit. Rebuild tvOS+OFLib with the same flag.
// GCC_PREPROCESSOR_DEFINITIONS = $(inherited) OF_USE_ANGLE=1
// OTHER_LDFLAGS = $(OF_CORE_LIBS) $(OF_ANGLE_APP_FRAMEWORKS) $(OF_ANGLE_LIBS)

ENABLE_BITCODE = NO
COMPRESS_PNG_FILES = NO
GCC_THUMB_SUPPORT = NO
TVOS_DEPLOYMENT_TARGET = 18.0
