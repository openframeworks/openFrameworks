#!/usr/bin/env bash
# of - openFrameworks CLI entrypoint
ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ROOT="$(realpath "$ROOT")"
OF_SCRIPT="$(realpath "$ROOT/scripts/of.sh")"

if [[ ! -f "$OF_SCRIPT" ]]; then
	echo "Error: of.sh not found at ${OF_SCRIPT}" >&2
	exit 1
fi

. "$OF_SCRIPT" "$@"
