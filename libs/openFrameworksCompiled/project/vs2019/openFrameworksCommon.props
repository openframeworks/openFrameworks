<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <OF_ROOT>$(MSBuildThisFileDirectory)\..\..\..\..\</OF_ROOT>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>kernel32.lib;user32.lib;gdi32.lib;winspool.lib;comdlg32.lib;advapi32.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;odbc32.lib;odbccp32.lib;wldap32.lib;mf.lib;mfplat.lib;mfuuid.lib;d3d11.lib;mfreadwrite.lib;xaudio2.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>C:\Program Files (x86)\Visual Leak Detector\lib\Win64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <CompileAs>CompileAsCpp</CompileAs>
      <AdditionalOptions>/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="OF_ROOT">
      <Value>$(OF_ROOT)</Value>
      <EnvironmentVariable>true</EnvironmentVariable>
    </BuildMacro>
  </ItemGroup>
  <!-- GLon12 (Mesa OpenGL -> D3D12): OF_USE_GLON12=1 copies libs/glon12/bin/vs/$(Platform)/*.dll next to the exe -->
  <PropertyGroup>
    <OF_USE_GLON12 Condition="'$(OF_USE_GLON12)'==''">0</OF_USE_GLON12>
    <OF_GLON12_BIN>$(OF_ROOT)libs\glon12\bin\vs\$(Platform)\</OF_GLON12_BIN>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(OF_USE_GLON12)'=='1'">
    <ClCompile>
      <PreprocessorDefinitions>OF_USE_GLON12=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="OFCopyGLon12" AfterTargets="Build" Condition="'$(OF_USE_GLON12)'=='1' and '$(ConfigurationType)'=='Application'">
    <ItemGroup>
      <OFGLon12Dll Include="$(OF_GLON12_BIN)*.dll" />
    </ItemGroup>
    <Error Condition="'@(OFGLon12Dll)'==''" Text="OF_USE_GLON12=1 but no GLon12 DLLs in $(OF_GLON12_BIN) - download the glon12 library (projectGenerator Libraries, or apothecary: TYPE=vs ./apothecary update glon12)" />
    <Copy SourceFiles="@(OFGLon12Dll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>